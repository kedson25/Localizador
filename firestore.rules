rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function approved() {
      return signedIn() && userProfile().data.isApproved == true;
    }

    function admin() {
      return approved() && userProfile().data.isAdmin == true;
    }

    match /users/{userId} {
      allow read: if approved() && (request.auth.uid == userId || admin());
      allow create: if false;
      allow update, delete: if admin();
    }

    match /coleta_listas/{listaId} {
      allow read: if approved();
      allow create, update: if approved();
      allow delete: if admin();

      match /itens/{itemId} {
        allow read, create, update: if approved();
        allow delete: if approved();
      }
    }

    match /refugo_scans_items/{scanId} {
      allow read, create, update, delete: if approved();
    }

    match /refugo/{docId} {
      allow read, create, update, delete: if approved();
    }

    match /coletor/{docId} {
      allow read, create, update, delete: if approved();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
