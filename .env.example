# ==========================================
# Variáveis de Ambiente - Coleta & Refugo App
# ==========================================

# 1. Supabase Client (Frontend / Vite)
# A anon key é pública por design e protegida por RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_SUPABASE_ANON_KEY

# 2. Supabase Server (Vercel Functions)
# Nunca exponha a SERVICE_ROLE no frontend ou em variáveis VITE_*.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU_SUPABASE_SERVICE_ROLE_KEY

# 3. Telemetria e Monitoramento de Erros (Opcional)
SENTRY_DSN=

# 4. Google Sheets Integration (Opcional - Espelho da Lista do Dia)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=

# ==========================================
# Firebase legado
# ==========================================
# As dependências Firebase ainda permanecem temporariamente no package.json
# somente para compatibilidade com endpoints antigos em /api que não são mais
# usados pelo frontend principal. Não configure novas credenciais Firebase.
